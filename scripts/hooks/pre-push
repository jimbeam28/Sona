#!/bin/bash
# pre-push hook: mirror GitHub CI checks locally before pushing,
# but only when the push touches code or test files (lib/**/*.dart or test/**/*.dart).
# Pure-doc/config pushes skip the checks to save time.
#
# When code/test changes are detected, runs the same checks as .github/workflows/ci.yml:
#   1. dart format --set-exit-if-changed lib test
#   2. flutter analyze --no-fatal-infos
#   3. flutter test
# Any failure aborts the push so you fix it locally instead of on GitHub.
#
# To bypass in an emergency: SKIP_PRE_PUSH=1 git push
#
# Install on a fresh clone:  bash scripts/install-hooks.sh

set -e

if [ -n "${SKIP_PRE_PUSH:-}" ]; then
  echo "[pre-push] SKIP_PRE_PUSH set, skipping checks."
  exit 0
fi

# git feeds push specs on stdin, one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
# Collect all files changed across every ref being pushed.
ZERO="0000000000000000000000000000000000000000"
CHANGED=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # branch deletion — nothing to check
  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch: diff the new tip against its first parent.
    # Fall back to listing all files in the tip for an initial commit (no parent).
    files=$(git diff --name-only "$local_sha^" "$local_sha" 2>/dev/null \
            || git show --name-only --pretty="" "$local_sha" 2>/dev/null \
            || true)
  else
    # Existing branch: diff old remote tip to new local tip.
    files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)
  fi
  CHANGED="$CHANGED"$'\n'"$files"
done

# Skip unless at least one .dart file under lib/ or test/ was touched.
if ! printf '%s' "$CHANGED" | grep -qE '^(lib|test)/.*\.dart$'; then
  echo "[pre-push] No code or test files changed (lib/ or test/*.dart) — skipping checks."
  exit 0
fi

echo "[pre-push] Code/test changes detected — running checks (same as .github/workflows/ci.yml)..."

echo ""
echo "[1/3] dart format --set-exit-if-changed lib test"
dart format --set-exit-if-changed lib test

echo ""
echo "[2/3] flutter analyze --no-fatal-infos"
flutter analyze --no-fatal-infos

echo ""
echo "[3/3] flutter test"
flutter test

echo ""
echo "[pre-push] All checks passed. Proceeding with push."
exit 0
